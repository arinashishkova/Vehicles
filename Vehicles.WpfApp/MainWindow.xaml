<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="600"
        Width="800"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/hands.ico">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- LEFT SIDE -->
        <StackPanel Grid.Column="0">

            <!-- ADD VEHICLE -->
            <TextBlock Text="Add vehicle"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,15"/>

            <TextBlock Text="Type:"/>

            <ComboBox x:Name="VehicleTypeComboBox"
                      Height="32"
                      Margin="0,5,0,12"/>

            <TextBlock Text="Brand:"/>

            <TextBox x:Name="BrandTextBox"
                     Height="32"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Model:"/>

            <TextBox x:Name="ModelTextBox"
                     Height="32"
                     Margin="0,5,0,12"/>

            <Button x:Name="AddButton"
                    Content="Add"
                    Height="36"
                    Click="AddButton_Click"/>


            <!-- SEPARATOR -->
            <Separator Margin="0,22,0,18"/>


            <!-- SELECTED VEHICLE -->
            <TextBlock Text="Selected vehicle"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="SelectedVehicleTextBlock"
                       Text="No vehicle selected"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>


            <!-- DISTANCE -->
            <TextBlock Text="Distance:"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,5,0,15">

                <TextBox x:Name="DistanceTextBox"
                         Width="120"
                         Height="30"/>

                <TextBlock Text="km"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

            </StackPanel>


            <!-- ACTIONS -->
            <TextBlock Text="Actions:"
                       Margin="0,0,0,7"/>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MoveButton"
                        Grid.Column="0"
                        Content="Move"
                        Height="34"
                        Margin="0,0,6,0"
                        Click="MoveButton_Click"/>

                <Button x:Name="DriveButton"
                        Grid.Column="1"
                        Content="Drive"
                        Height="34"
                        Margin="3,0,3,0"
                        Click="DriveButton_Click"/>

                <Button x:Name="SwimButton"
                        Grid.Column="2"
                        Content="Swim"
                        Height="34"
                        Margin="6,0,0,0"
                        Click="SwimButton_Click"/>

            </Grid>

        </StackPanel>


        <!-- RIGHT SIDE -->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>


            <!-- VEHICLE IMAGE -->
            <Image Grid.Row="0"
                   Source="Assets/vehicles.png"
                   Height="90"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"/>


            <!-- GARAGES TITLE -->
            <TextBlock Grid.Row="1"
                       Text="Garages"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,7"/>


            <!-- GARAGES -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- CARS GARAGE -->
                <GroupBox Grid.Column="0"
          Header="Cars garage">

                    <Grid Margin="5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="CarsListBox"
                 Grid.Row="0"
                 DisplayMemberPath="DisplayName"
                 SelectionChanged="GarageListBox_SelectionChanged"
                 Margin="0,0,0,8"/>

                        <Button x:Name="RemoveCarButton"
                Grid.Row="1"
                Content="Remove"
                Height="32"
                Click="RemoveCarButton_Click"/>

                    </Grid>

                </GroupBox>


                <!-- BOATS GARAGE -->
                <GroupBox Grid.Column="2"
          Header="Boats garage">

                    <Grid Margin="5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox x:Name="BoatsListBox"
                                 Grid.Row="0"
                                 DisplayMemberPath="DisplayName"
                                 SelectionChanged="GarageListBox_SelectionChanged"
                                 Margin="0,0,0,8"/>

                        <Button x:Name="RemoveBoatButton"
                                    Grid.Row="1"
                                    Content="Remove"
                                    Height="32"
                                    Click="RemoveBoatButton_Click"/>

                    </Grid>

                </GroupBox>

            </Grid>


            <!-- LOG TITLE -->
            <TextBlock Grid.Row="3"
                       Text="Activity log"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>


            <!-- ACTIVITY LOG -->
            <ListBox x:Name="LogListBox"
                     Grid.Row="4"/>

        </Grid>

    </Grid>

</Window>